            565.0443262815544,
            243.51536664348112
          ],
          "text": "Abstract",
          "reading_order": 2,
          "attributes": {
            "is_continued_from": null,
            "is_continued_on_next_page": false
          }
        },
        {
          "element_id": "sp00000_p1_e004",
          "type": "text",
          "bbox": [
            56.16541288934006,
            247.51536664348112,
            565.0443262815544,
            291.5153666434811
          ],
          "text": "This paper presents a novel framework for the generation of synthetic document datasets with pixel-perfect ground-truth layouts. We address the critical issue of bounding box coordinate drift in traditional layout analysis. By intercepting layout information directly inside the rendering lifecycle, we eliminate approximation errors. Experimental evaluations demonstrate substantial improvements in downstream object detection training efficiency.",
          "reading_order": 3,
          "attributes": {
            "is_continued_from": null,
            "is_continued_on_next_page": false
          }
        },
        {
          "element_id": "sp00000_p1_e000",
          "type": "page_footer",
          "bbox": [
